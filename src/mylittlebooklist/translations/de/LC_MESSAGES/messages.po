#: src/mylittlebooklist/routes/auth.py
msgid "Invalid form token – please reload the page."
msgstr "Ungültiges Formular-Token – bitte Seite neu laden."

#: src/mylittlebooklist/routes/auth.py
msgid "Wrong username or password."
msgstr "Benutzername oder Passwort falsch."

#: src/mylittlebooklist/routes/auth.py
msgid "Current password is wrong."
msgstr "Aktuelles Passwort ist falsch."

#: src/mylittlebooklist/routes/auth.py
msgid "New password must be at least 4 characters long."
msgstr "Neues Passwort muss mindestens 4 Zeichen haben."

#: src/mylittlebooklist/routes/auth.py
msgid "Password changed."
msgstr "Passwort geändert."

#: src/mylittlebooklist/routes/books.py
msgid "Book added to your collection."
msgstr "Buch zu deiner Sammlung hinzugefügt."

#: src/mylittlebooklist/routes/books.py
msgid "Book removed from your collection."
msgstr "Buch aus deiner Sammlung entfernt."

#: src/mylittlebooklist/routes/books.py
msgid "ISBN must have 10 or 13 digits."
msgstr "ISBN muss 10 oder 13 Stellen haben."

#: src/mylittlebooklist/routes/books.py
msgid "Year of publication must be a number."
msgstr "Erscheinungsjahr muss eine Zahl sein."

#: src/mylittlebooklist/routes/books.py
msgid "Please enter a valid ISBN (10 or 13 digits)."
msgstr "Bitte eine gültige ISBN (10 oder 13 Stellen) eingeben."

#: src/mylittlebooklist/routes/books.py
msgid "Nothing found on OpenLibrary – please fill in manually."
msgstr "Bei OpenLibrary nichts gefunden – bitte manuell ausfüllen."

#: src/mylittlebooklist/routes/books.py
msgid "Data taken from OpenLibrary – please check and save."
msgstr "Daten von OpenLibrary übernommen – bitte prüfen und speichern."

#: src/mylittlebooklist/routes/books.py
msgid "This book is already in the catalog and was added to your collection."
msgstr "Das Buch ist schon im Katalog und wurde deiner Sammlung hinzugefügt."

#: src/mylittlebooklist/routes/books.py
msgid "Title is required."
msgstr "Titel ist ein Pflichtfeld."

#: src/mylittlebooklist/routes/books.py
msgid "Book saved."
msgstr "Buch gespeichert."

#: src/mylittlebooklist/routes/books.py
msgid "Another book with this ISBN already exists."
msgstr "Ein anderes Buch mit dieser ISBN existiert bereits."

#: src/mylittlebooklist/routes/books.py
msgid "Changes saved."
msgstr "Änderungen gespeichert."

#: src/mylittlebooklist/routes/users.py
msgid "Enter a username and a password (at least 4 characters)."
msgstr "Benutzername und Passwort (mind. 4 Zeichen) angeben."

#: src/mylittlebooklist/routes/users.py
#, python-format
msgid "User “%(name)s” created."
msgstr "Benutzer „%(name)s“ angelegt."

#: src/mylittlebooklist/routes/users.py
msgid "Username already exists."
msgstr "Benutzername existiert bereits."

#: src/mylittlebooklist/routes/users.py
msgid "You cannot delete yourself or remove your own admin rights."
msgstr "Du kannst dich nicht selbst löschen oder dir die Admin-Rechte entziehen."

#: src/mylittlebooklist/routes/users.py
msgid "User deleted."
msgstr "Benutzer gelöscht."

#: src/mylittlebooklist/routes/users.py
msgid "Password must be at least 4 characters long."
msgstr "Passwort muss mindestens 4 Zeichen haben."

#: src/mylittlebooklist/routes/users.py
msgid "Password reset."
msgstr "Passwort zurückgesetzt."

