# Kopieren nach .env und anpassen.

# Zufälliger, geheimer Schlüssel für Session-Cookies (z. B. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Ohne ihn verfallen alle Logins bei jedem Neustart.
SECRET_KEY=bitte-aendern

# Erster Admin – wird nur angelegt, wenn die Datenbank noch keine Benutzer hat.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Pfad zur SQLite-Datei (im Container bereits /data/books.db).
# DB_PATH=books.db

# Demo-Daten sind optional, siehe README ("Demo-Daten").
