# Copy to .env and adjust.

# Random secret key for session cookies (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Without it, all logins expire on every restart.
SECRET_KEY=change-me

# First admin – only created if the database has no users yet.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Path to the SQLite file (already /data/books.db in the container).
# DB_PATH=books.db

# Demo data is optional, see README ("Demo data").
